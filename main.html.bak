<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prabuddha — AI Engineer & Backend Developer</title>
<meta name="description" content="Portfolio of Prabuddha — an AI engineer and backend developer building RAG pipelines, Golang microservices, and multimodal AI systems.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Gotham:wght@400;700&family=Inter:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<!-- Using Nunito as a close web-safe substitute for Gotham -->
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,300;0,400;0,600;0,700;0,800;1,300;1,400&family=Inter:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
/* ════════════════════════════════════════
   DESIGN TOKENS  (hamishw color palette)
   ════════════════════════════════════════ */
:root {
  --background: #111;
  --backgroundLight: #1b1b1b;
  --backgroundDark: #080808;
  --primary: rgb(0,229,255);         /* hamish teal/cyan */
  --primaryLight: rgba(0,229,255,0.4);
  --accent: #A66CFF;
  --text: rgba(255,255,255,0.9);
  --textBody: rgba(255,255,255,0.7);
  --textLight: rgba(255,255,255,0.4);
  --border: rgba(255,255,255,0.08);
  --duration: 0.4s;
  --ease: cubic-bezier(0.4,0,0.2,1);

  /* spacing / type scale from hamish */
  --space-xs:  4px;
  --space-s:   8px;
  --space-m:  16px;
  --space-l:  24px;
  --space-xl: 40px;
  --space-2xl:80px;
  --space-3xl:160px;
}

*, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; font-size:16px; }
body {
  background: var(--background);
  color: var(--text);
  font-family: 'Nunito Sans', system-ui, sans-serif;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ─── Skip link ─── */
.skip-link {
  position:fixed; top:-100%; left:50%; transform:translateX(-50%);
  background:var(--primary); color:#000; padding:12px 24px;
  border-radius:0 0 8px 8px; font-weight:700; z-index:9999;
  transition:top 0.2s; text-decoration:none;
}
.skip-link:focus { top:0; }

/* ─── Displacement sphere canvas ─── */
#sphere-canvas {
  position:fixed; top:0; left:0; width:100vw; height:100vh;
  pointer-events:none; z-index:0; opacity:1;
}

/* ─── Nav ─── */
header {
  position:fixed; top:0; left:0; right:0;
  z-index:100;
  padding:0 var(--space-xl);
  display:flex; align-items:center; justify-content:space-between;
  height:72px;
}
.nav-logo {
  font-size:22px; font-weight:800; letter-spacing:-0.03em;
  color:var(--text); text-decoration:none;
  display:flex; align-items:center; gap:10px;
}
.nav-logo svg { width:32px; height:32px; }
.nav-links {
  display:flex; gap:var(--space-xl); list-style:none;
}
.nav-links a {
  font-size:14px; font-weight:600; letter-spacing:0.05em;
  color:var(--textLight); text-decoration:none;
  text-transform:uppercase; transition:color var(--duration) var(--ease);
  position:relative; padding-bottom:4px;
}
.nav-links a::after {
  content:''; position:absolute; bottom:0; left:0; right:100%; height:2px;
  background:var(--primary); transition:right 0.3s var(--ease);
}
.nav-links a:hover { color:var(--text); }
.nav-links a:hover::after { right:0; }
.nav-socials { display:flex; gap:var(--space-m); }
.nav-socials a { color:var(--textLight); transition:color var(--duration) var(--ease); display:flex; align-items:center; }
.nav-socials a:hover { color:var(--text); }
.nav-socials svg { width:20px; height:20px; fill:currentColor; }

/* ─── INTRO section ─── */
#intro {
  position:relative; z-index:1;
  min-height:100vh;
  display:flex; flex-direction:column; justify-content:center;
  padding:0 var(--space-2xl); padding-top:72px;
}
.intro-text { max-width:860px; }
.intro-index {
  font-size:12px; font-weight:700; letter-spacing:0.2em;
  color:var(--primary); text-transform:uppercase;
  margin-bottom:var(--space-l);
  display:flex; align-items:center; gap:12px;
  opacity:0; transform:translateY(20px);
  animation:fadeUp 0.8s 0.1s var(--ease) forwards;
}
.intro-index::after { content:''; flex:1; max-width:48px; height:2px; background:var(--primary); }

.intro-title {
  font-size:clamp(56px, 9vw, 120px);
  font-weight:800;
  line-height:1;
  letter-spacing:-0.05em;
  color:var(--text);
  margin-bottom:var(--space-l);
  opacity:0; transform:translateY(30px);
  animation:fadeUp 0.9s 0.25s var(--ease) forwards;
}

.intro-role {
  font-size:clamp(18px, 2.5vw, 28px);
  font-weight:300;
  color:var(--textBody);
  margin-bottom:var(--space-xl);
  line-height:1.5;
  opacity:0; transform:translateY(20px);
  animation:fadeUp 0.9s 0.4s var(--ease) forwards;
}
.intro-role strong { color:var(--text); font-weight:600; }

/* Animated role words — hamish style */
.role-words { display:inline; position:relative; }
.role-word {
  display:none;
  color:var(--primary);
}
.role-word.active { display:inline; }

.intro-cta {
  display:flex; gap:var(--space-m); flex-wrap:wrap;
  opacity:0; transform:translateY(20px);
  animation:fadeUp 0.9s 0.55s var(--ease) forwards;
}
.scroll-btn {
  display:inline-flex; align-items:center; gap:10px;
  font-size:13px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase;
  color:var(--text); text-decoration:none;
  padding:14px 28px; border:2px solid var(--border);
  border-radius:4px;
  transition:border-color 0.3s, color 0.3s, background 0.3s;
}
.scroll-btn:hover { border-color:var(--primary); color:var(--primary); }
.scroll-btn svg { width:16px; height:16px; fill:currentColor; }
.scroll-btn-filled { background:var(--primary); border-color:var(--primary); color:#000; }
.scroll-btn-filled:hover { background:transparent; color:var(--primary); }

/* Scroll indicator */
.scroll-indicator {
  position:absolute; bottom:40px; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:8px;
  opacity:0; animation:fadeIn 1s 1.2s forwards;
}
.scroll-indicator span {
  font-size:11px; letter-spacing:0.2em; text-transform:uppercase;
  color:var(--textLight); writing-mode:vertical-rl;
}
.scroll-line {
  width:2px; height:60px;
  background:linear-gradient(to bottom, var(--primary), transparent);
  animation:scrollLine 1.5s ease-in-out infinite;
}
@keyframes scrollLine {
  0%   { transform:scaleY(1); transform-origin:top; }
  50%  { transform:scaleY(0); transform-origin:top; }
  51%  { transform:scaleY(0); transform-origin:bottom; }
  100% { transform:scaleY(1); transform-origin:bottom; }
}

/* ─── PROJECT sections (hamish full-viewport style) ─── */
.project-section {
  position:relative; z-index:1;
  min-height:100vh;
  display:grid; grid-template-columns:1fr 1fr; align-items:center;
  padding:var(--space-3xl) var(--space-2xl);
  gap:var(--space-2xl);
  overflow:hidden;
}
.project-section.reverse { grid-template-columns:1fr 1fr; }
.project-section.reverse .project-details { order:1; }
.project-section.reverse .project-preview { order:0; }

.project-index {
  font-size:11px; font-weight:700; letter-spacing:0.2em;
  color:var(--primary); text-transform:uppercase;
  margin-bottom:var(--space-m);
  display:flex; align-items:center; gap:10px;
}
.project-index::after { content:''; width:32px; height:2px; background:var(--primary); }
.project-title {
  font-size:clamp(28px,4vw,52px); font-weight:800;
  letter-spacing:-0.03em; line-height:1.1;
  color:var(--text); margin-bottom:var(--space-m);
}
.project-description {
  font-size:17px; font-weight:300; line-height:1.7;
  color:var(--textBody); margin-bottom:var(--space-xl);
  max-width:480px;
}
.project-tags { display:flex; flex-wrap:wrap; gap:var(--space-s); margin-bottom:var(--space-xl); }
.project-tag {
  font-size:11px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase;
  color:var(--primary); padding:5px 12px;
  border:1.5px solid rgba(0,229,255,0.3); border-radius:3px;
}
.project-metrics { display:flex; gap:var(--space-xl); margin-bottom:var(--space-xl); }
.project-metric { }
.project-metric-value {
  font-size:32px; font-weight:800; letter-spacing:-0.03em;
  color:var(--text); line-height:1;
}
.project-metric-value span { color:var(--primary); }
.project-metric-label {
  font-size:11px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase;
  color:var(--textLight); margin-top:4px;
}
.project-link-row { display:flex; gap:var(--space-m); }

/* ─── Device Mockup (phone) ─── */
.project-preview {
  display:flex; align-items:center; justify-content:center;
  position:relative;
}
.device-phone {
  width:280px; height:560px;
  background:var(--backgroundLight);
  border:2px solid rgba(255,255,255,0.12);
  border-radius:44px;
  position:relative; overflow:hidden;
  box-shadow: 0 40px 120px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.05);
  transform:perspective(1200px) rotateY(-12deg) rotateX(4deg);
  transition:transform 0.6s var(--ease);
}
.project-section:hover .device-phone { transform:perspective(1200px) rotateY(-4deg) rotateX(2deg); }
.device-phone::before {
  content:''; position:absolute; top:16px; left:50%; transform:translateX(-50%);
  width:80px; height:6px; background:rgba(255,255,255,0.15);
  border-radius:3px; z-index:2;
}
.device-phone::after {
  content:''; position:absolute; bottom:12px; left:50%; transform:translateX(-50%);
  width:100px; height:4px; background:rgba(255,255,255,0.12);
  border-radius:2px; z-index:2;
}
.device-screen {
  width:100%; height:100%; overflow:hidden;
  background:var(--backgroundDark);
  display:flex; flex-direction:column; align-items:center; justify-content:flex-start;
  padding-top:40px;
  position:relative;
}

/* ─── Desktop Mockup ─── */
.device-laptop {
  width:520px; max-width:100%;
  position:relative;
}
.device-laptop-screen {
  width:100%; padding-bottom:62.5%; /* 16:10 */
  background:var(--backgroundDark);
  border:2px solid rgba(255,255,255,0.12);
  border-radius:12px 12px 0 0;
  overflow:hidden; position:relative;
  box-shadow: 0 20px 80px rgba(0,0,0,0.6);
}
.device-laptop-base {
  height:20px; background:var(--backgroundLight);
  border-radius:0 0 4px 4px;
  border:2px solid rgba(255,255,255,0.08);
  border-top:none;
  position:relative;
}
.device-laptop-base::after {
  content:''; position:absolute; top:8px; left:50%; transform:translateX(-50%);
  width:80px; height:4px; background:rgba(255,255,255,0.1); border-radius:2px;
}
.device-laptop-screen-inner {
  position:absolute; inset:0; overflow:hidden;
}

/* ─── Mockup content inside devices ─── */
.mock-dashboard {
  width:100%; height:100%;
  background: linear-gradient(160deg, #0d0d1a 0%, #0a1628 100%);
  padding:16px; display:flex; flex-direction:column; gap:8px;
}
.mock-topbar {
  height:28px; background:rgba(255,255,255,0.05);
  border-radius:4px; display:flex; align-items:center; padding:0 8px; gap:6px;
}
.mock-dot { width:6px; height:6px; border-radius:50%; }
.mock-dot.r { background:#ff5f57; }
.mock-dot.y { background:#febc2e; }
.mock-dot.g { background:#28c840; }
.mock-bar { height:4px; border-radius:2px; background:rgba(0,229,255,0.3); margin-top:2px; }
.mock-chart {
  flex:1; background:rgba(0,229,255,0.04);
  border:1px solid rgba(0,229,255,0.1); border-radius:6px;
  display:flex; align-items:flex-end; padding:8px; gap:4px;
}
.mock-bar-chart {
  flex:1; background:rgba(0,229,255,0.3); border-radius:2px 2px 0 0;
  transition:height 0.5s;
}
.mock-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; }
.mock-card {
  background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.06);
  border-radius:6px; padding:10px;
}
.mock-card-label { font-size:8px; color:rgba(255,255,255,0.4); letter-spacing:0.1em; text-transform:uppercase; }
.mock-card-val { font-size:16px; font-weight:700; color:rgba(0,229,255,0.9); }

.mock-rag {
  width:100%; height:100%;
  background:linear-gradient(160deg, #0a0a14 0%, #050b18 100%);
  padding:16px; display:flex; flex-direction:column; gap:8px;
}
.mock-msg { display:flex; gap:8px; align-items:flex-start; }
.mock-avatar { width:24px; height:24px; border-radius:50%; flex-shrink:0; margin-top:2px; }
.mock-bubble {
  padding:8px 12px; border-radius:12px;
  font-size:9px; line-height:1.5; max-width:85%;
}
.mock-bubble.ai { background:rgba(0,229,255,0.08); color:rgba(255,255,255,0.8); border:1px solid rgba(0,229,255,0.15); }
.mock-bubble.user { background:rgba(166,108,255,0.12); color:rgba(255,255,255,0.8); margin-left:auto; }
.mock-typing { display:flex; gap:4px; align-items:center; padding:8px 12px; }
.mock-typing span {
  width:5px; height:5px; border-radius:50%;
  background:rgba(0,229,255,0.6);
  animation:typingDot 1.2s ease-in-out infinite;
}
.mock-typing span:nth-child(2) { animation-delay:0.2s; }
.mock-typing span:nth-child(3) { animation-delay:0.4s; }
@keyframes typingDot { 0%,60%,100%{opacity:0.3;transform:scale(1)} 30%{opacity:1;transform:scale(1.3)} }

.mock-iot {
  width:100%; height:100%;
  background:linear-gradient(160deg, #040d10 0%, #051418 100%);
  padding:16px; display:flex; flex-direction:column; gap:8px;
}
.mock-sensor-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:6px; }
.mock-sensor {
  background:rgba(0,229,255,0.05); border:1px solid rgba(0,229,255,0.12);
  border-radius:6px; padding:8px; text-align:center;
}
.mock-sensor-val { font-size:14px; font-weight:700; color:rgba(0,229,255,0.9); }
.mock-sensor-lbl { font-size:7px; color:rgba(255,255,255,0.4); letter-spacing:0.1em; text-transform:uppercase; }
.mock-wave {
  height:40px; position:relative; overflow:hidden;
  background:rgba(0,229,255,0.03); border-radius:4px;
  border:1px solid rgba(0,229,255,0.08);
}
.mock-wave svg { width:100%; height:100%; }

.mock-sentiment {
  width:100%; height:100%;
  background:linear-gradient(160deg, #0a0510 0%, #0d0518 100%);
  padding:16px; display:flex; flex-direction:column; gap:10px;
  align-items:center;
}
.mock-face {
  width:80px; height:80px; border-radius:50%;
  background:rgba(166,108,255,0.1); border:2px solid rgba(166,108,255,0.3);
  display:flex; align-items:center; justify-content:center;
  font-size:36px;
}
.mock-emotion-bars { width:100%; display:flex; flex-direction:column; gap:5px; }
.mock-em-row { display:flex; align-items:center; gap:6px; }
.mock-em-label { font-size:8px; color:rgba(255,255,255,0.5); width:40px; }
.mock-em-bar { height:5px; border-radius:2px; background:rgba(166,108,255,0.6); }
.mock-em-val { font-size:8px; color:rgba(166,108,255,0.8); width:24px; text-align:right; }

/* ─── DETAILS / About ─── */
#details {
  position:relative; z-index:1;
  min-height:100vh;
  display:grid; grid-template-columns:1fr 1fr;
  align-items:center;
  padding:var(--space-3xl) var(--space-2xl);
  gap:var(--space-2xl);
  overflow:hidden;
}
.details-image-col { display:flex; align-items:center; justify-content:center; }
.profile-frame {
  width:380px; max-width:100%; aspect-ratio:3/4;
  position:relative;
}
.profile-bg {
  position:absolute; inset:0; border-radius:20px;
  background:linear-gradient(135deg, rgba(0,229,255,0.1) 0%, rgba(166,108,255,0.12) 100%);
  border:1px solid rgba(255,255,255,0.06);
}
.profile-placeholder {
  position:absolute; inset:24px; border-radius:14px;
  background:linear-gradient(160deg, #1a1a2e 0%, #16213e 100%);
  display:flex; align-items:center; justify-content:center;
  overflow:hidden; border:1px solid rgba(255,255,255,0.06);
}
.profile-placeholder svg { width:120px; height:120px; fill:rgba(0,229,255,0.15); }
.profile-badge {
  position:absolute; bottom:-16px; right:-16px;
  background:var(--background); border:1px solid rgba(0,229,255,0.3);
  border-radius:12px; padding:16px 20px;
  display:flex; flex-direction:column; gap:2px;
  box-shadow:0 20px 60px rgba(0,0,0,0.5);
}
.profile-badge-value { font-size:28px; font-weight:800; color:var(--primary); letter-spacing:-0.03em; line-height:1; }
.profile-badge-label { font-size:10px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:var(--textLight); }

.details-text-col {}
.details-label {
  font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase;
  color:var(--primary); margin-bottom:var(--space-m);
  display:flex; align-items:center; gap:10px;
}
.details-label::after { content:''; width:32px; height:2px; background:var(--primary); }
.details-heading {
  font-size:clamp(32px,4vw,56px); font-weight:800;
  letter-spacing:-0.03em; line-height:1.1;
  color:var(--text); margin-bottom:var(--space-l);
}
.details-body {
  font-size:17px; font-weight:300; line-height:1.8;
  color:var(--textBody); margin-bottom:var(--space-l);
}
.details-body a { color:var(--primary); text-decoration:none; }
.details-body a:hover { text-decoration:underline; }

.details-skills { margin-bottom:var(--space-xl); }
.details-skills-label {
  font-size:11px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase;
  color:var(--textLight); margin-bottom:var(--space-m);
}
.skills-row { display:flex; flex-wrap:wrap; gap:8px; }
.skill-pill {
  font-size:12px; font-weight:600; letter-spacing:0.05em;
  color:var(--textBody); padding:6px 14px;
  border:1px solid var(--border); border-radius:100px;
  transition:border-color 0.3s, color 0.3s;
}
.skill-pill:hover { border-color:var(--primary); color:var(--text); }

.exp-items { display:flex; flex-direction:column; gap:var(--space-l); margin-bottom:var(--space-xl); }
.exp-item {
  padding:var(--space-l); background:rgba(255,255,255,0.03);
  border:1px solid var(--border); border-radius:10px;
  transition:border-color 0.3s;
  position:relative; overflow:hidden;
}
.exp-item::before {
  content:''; position:absolute; left:0; top:0; bottom:0; width:3px;
  background:var(--primary); transform:scaleY(0); transition:transform 0.3s;
  transform-origin:bottom;
}
.exp-item:hover { border-color:rgba(0,229,255,0.2); }
.exp-item:hover::before { transform:scaleY(1); }
.exp-item-head { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:var(--space-s); }
.exp-company-name { font-size:16px; font-weight:700; color:var(--text); }
.exp-period {
  font-size:11px; font-weight:600; letter-spacing:0.08em;
  color:var(--textLight); padding:3px 10px; background:rgba(255,255,255,0.05); border-radius:100px;
}
.exp-period.active { color:var(--primary); background:rgba(0,229,255,0.08); }
.exp-role-title { font-size:13px; color:var(--primary); font-weight:600; letter-spacing:0.05em; margin-bottom:8px; }
.exp-desc { font-size:13px; color:var(--textLight); line-height:1.6; }

/* ─── Contact footer ─── */
#contact {
  position:relative; z-index:1;
  min-height:100vh;
  display:flex; flex-direction:column; justify-content:center;
  align-items:flex-start;
  padding:var(--space-3xl) var(--space-2xl);
  overflow:hidden;
}
.contact-pre {
  font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase;
  color:var(--primary); margin-bottom:var(--space-l);
  display:flex; align-items:center; gap:10px;
}
.contact-pre::after { content:''; width:32px; height:2px; background:var(--primary); }
.contact-heading {
  font-size:clamp(48px,8vw,120px); font-weight:800;
  letter-spacing:-0.05em; line-height:0.9;
  color:var(--text); margin-bottom:var(--space-xl);
}
.contact-sub {
  font-size:18px; font-weight:300; line-height:1.7;
  color:var(--textBody); max-width:540px; margin-bottom:var(--space-xl);
}
.contact-actions { display:flex; gap:var(--space-m); flex-wrap:wrap; margin-bottom:var(--space-2xl); }

.footer-bottom {
  position:absolute; bottom:var(--space-xl); left:var(--space-2xl); right:var(--space-2xl);
  display:flex; justify-content:space-between; align-items:center;
  border-top:1px solid var(--border); padding-top:var(--space-l);
}
.footer-copy { font-size:13px; color:var(--textLight); }
.footer-links { display:flex; gap:var(--space-l); }
.footer-links a { font-size:13px; color:var(--textLight); text-decoration:none; transition:color 0.3s; }
.footer-links a:hover { color:var(--text); }

/* ─── Reveal animations ─── */
.reveal {
  opacity:0; transform:translateY(40px);
  transition:opacity 0.8s var(--ease), transform 0.8s var(--ease);
}
.reveal.visible { opacity:1; transform:none; }
.reveal-delay-1 { transition-delay:0.1s; }
.reveal-delay-2 { transition-delay:0.2s; }
.reveal-delay-3 { transition-delay:0.3s; }
.reveal-delay-4 { transition-delay:0.4s; }

/* ─── Section divider ─── */
.section-divider {
  position:relative; z-index:1;
  height:1px; background:var(--border);
  margin:0 var(--space-2xl);
}

/* ─── Floating gradient bg for projects ─── */
.project-section::before {
  content:''; position:absolute; inset:0; pointer-events:none; z-index:0;
  background:radial-gradient(ellipse 80% 60% at 50% 50%, rgba(0,229,255,0.02), transparent 70%);
}
.project-section.accent-purple::before {
  background:radial-gradient(ellipse 80% 60% at 50% 50%, rgba(166,108,255,0.03), transparent 70%);
}
.project-section > * { position:relative; z-index:1; }

/* ─── Keyframes ─── */
@keyframes fadeUp {
  from { opacity:0; transform:translateY(30px); }
  to   { opacity:1; transform:none; }
}
@keyframes fadeIn {
  from { opacity:0; }
  to   { opacity:1; }
}

/* ─── Scrollbar ─── */
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-track { background:#000; }
::-webkit-scrollbar-thumb { background:rgba(0,229,255,0.3); border-radius:2px; }

/* ─── Responsive ─── */
@media (max-width:1024px) {
  :root { --space-3xl:100px; --space-2xl:48px; }
  .project-section, #details {
    grid-template-columns:1fr; padding:80px var(--space-xl);
  }
  .project-section.reverse .project-details { order:0; }
  .project-section.reverse .project-preview { order:1; }
  .device-phone { transform:none; width:220px; height:440px; }
  .project-section:hover .device-phone { transform:none; }
  .device-laptop { width:100%; max-width:420px; }
  header { padding:0 var(--space-l); }
  .nav-links { display:none; }
  #intro { padding:80px var(--space-l); }
  .contact-heading { font-size:clamp(48px,10vw,80px); }
  .footer-bottom { position:static; margin-top:var(--space-xl); }
  #contact { padding-bottom:var(--space-2xl); }
  .profile-frame { width:260px; }
}
@media (max-width:600px) {
  .intro-title { font-size:clamp(44px,14vw,60px); }
  .project-metrics { gap:var(--space-l); }
  .project-metric-value { font-size:24px; }
}
@media (prefers-reduced-motion:reduce) {
  *, *::before, *::after { animation-duration:0.01ms !important; transition-duration:0.01ms !important; }
  .scroll-line { animation:none; }
}
</style>
</head>
