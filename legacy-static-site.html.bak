  <svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
</a>

<script>
/* CURSOR */
(function(){
  const c=document.getElementById('cur'),r=document.getElementById('cur-ring');
  let mx=window.innerWidth/2,my=window.innerHeight/2,rx=mx,ry=my;
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;});
  function loop(){rx+=(mx-rx)*.18;ry+=(my-ry)*.18;c.style.left=mx+'px';c.style.top=my+'px';r.style.left=rx+'px';r.style.top=ry+'px';requestAnimationFrame(loop);}
  loop();
  document.querySelectorAll('a,button').forEach(el=>{
    el.addEventListener('mouseenter',()=>{r.style.width='52px';r.style.height='52px';r.style.borderColor='rgba(0,229,255,.6)';});
    el.addEventListener('mouseleave',()=>{r.style.width='36px';r.style.height='36px';r.style.borderColor='rgba(0,229,255,.45)';});
  });
})();

/* PARTICLES */
(function(){
  const c=document.getElementById('particles');
  for(let i=0;i<26;i++){
    const p=document.createElement('div');p.className='particle';
    const left=Math.random()*100,dur=14+Math.random()*18,del=-Math.random()*18,dx=(Math.random()-.5)*100;
    p.style.cssText=`left:${left}%;--dur:${dur}s;--del:${del}s;--dx:${dx}px;opacity:${.15+Math.random()*.4};`;
    c.appendChild(p);
  }
})();


/* 3D GLOBE */
(function(){
  const canvas=document.getElementById('globe-canvas'),labDiv=document.getElementById('globe-labels');
  if(!canvas)return;
  const ctx=canvas.getContext('2d');
  let W,H,cx,cy,R,dpr=Math.min(window.devicePixelRatio||1,2);
  function resize(){
    const rect=canvas.getBoundingClientRect();
    canvas.width=(rect.width*dpr)|0;canvas.height=(rect.height*dpr)|0;
    ctx.scale(dpr,dpr);W=rect.width;H=rect.height;cx=W/2;cy=H/2;R=Math.min(W,H)*.38;
  }
  resize();
  try{const ro=new ResizeObserver(()=>{ctx.resetTransform();resize();});ro.observe(canvas);}catch(e){}
  const N=900,PHI=Math.PI*(3-Math.sqrt(5));
  const sdots=Array.from({length:N},(_,i)=>{const y=1-(i/(N-1))*2,r=Math.sqrt(1-y*y),th=PHI*i;return[r*Math.cos(th),y,r*Math.sin(th)];});
  const stack=[
    {n:'Python',c:'#3b88c3',lat:38,lon:20},{n:'Golang',c:'#00add8',lat:25,lon:85},
    {n:'LangChain',c:'#1c9e6e',lat:-8,lon:145},{n:'FAISS',c:'#00e5ff',lat:52,lon:-55},
    {n:'Qdrant',c:'#dc244c',lat:15,lon:-95},{n:'Docker',c:'#2496ed',lat:-28,lon:65},
    {n:'PostgreSQL',c:'#336791',lat:58,lon:-25},{n:'React Native',c:'#61dafb',lat:2,lon:168},
    {n:'Whisper',c:'#a66cff',lat:-48,lon:-115},{n:'TensorFlow',c:'#ff6f00',lat:42,lon:115},
    {n:'LlamaIndex',c:'#00e5ff',lat:-18,lon:-18},{n:'Firebase',c:'#ffca28',lat:-38,lon:98},
    {n:'ESP32',c:'#e7352b',lat:68,lon:55},{n:'RAG',c:'#a66cff',lat:8,lon:-155},
    {n:'C++',c:'#00599c',lat:-58,lon:28},
    {n:'DistilBERT',c:'#f6c90e',lat:-14,lon:60},{n:'ViT',c:'#a66cff',lat:32,lon:-140},
    {n:'FastAPI',c:'#009688',lat:-40,lon:-38},{n:'Hugging Face',c:'#ffcc00',lat:48,lon:-88},
    {n:'OpenCV',c:'#5c3ee8',lat:20,lon:35},{n:'Git',c:'#f05032',lat:62,lon:132},
    {n:'AWS',c:'#ff9900',lat:-56,lon:-55},{n:'Streamlit',c:'#ff4b4b',lat:16,lon:-120},
    {n:'NumPy',c:'#4dabcf',lat:40,lon:-110},{n:'Redis',c:'#dc382d',lat:-30,lon:-178},
  ];
  function ll2v(lat,lon,r){const phi=(90-lat)*Math.PI/180,th=lon*Math.PI/180;return[r*Math.sin(phi)*Math.cos(th),r*Math.cos(phi),r*Math.sin(phi)*Math.sin(th)];}
  function rotY(x,z,a){return[x*Math.cos(a)+z*Math.sin(a),-x*Math.sin(a)+z*Math.cos(a)];}
  function proj(x,y,z,fov){const f=fov/(fov+z);return[cx+x*f,cy-y*f];}
  const lels=stack.map(t=>{const el=document.createElement('div');el.className='glbl';el.textContent=t.n;el.style.setProperty('--lc',t.c);labDiv.appendChild(el);return el;});
  let rot=0,vel=.004,drag=false,lx=0;
  canvas.addEventListener('mousedown',e=>{drag=true;lx=e.clientX;vel=0;});
  window.addEventListener('mousemove',e=>{if(!drag)return;vel=(e.clientX-lx)*.004;rot+=vel;lx=e.clientX;});
  window.addEventListener('mouseup',()=>{drag=false;if(Math.abs(vel)<.001)vel=.004;});
  let gt=0,hbt=0;
  function draw(){
    gt+=0.012;hbt+=0.13;
    ctx.clearRect(0,0,W,H);
    const FOV=W*.75;
    /* warm sun glow at center */
    const isLight=document.body.classList.contains('light');
    /* heartbeat pulse — sharp spike like lub-dub */
    const s=Math.sin(hbt);const pulse=s>0?Math.pow(s,7):0;
    window._globePulse=pulse;
    const glowA=isLight?0.025:0.06;
    const glowB=isLight?0.01:0.025;
    const gc1=isLight?`rgba(0,147,179,${(glowA+0.03*pulse).toFixed(3)})`:`rgba(255,170,50,${(glowA+0.04*pulse).toFixed(3)})`;
    const gc2=isLight?`rgba(0,100,160,${(glowB+0.01*pulse).toFixed(3)})`:`rgba(255,110,20,${(glowB+0.015*pulse).toFixed(3)})`;
    const sg=ctx.createRadialGradient(cx,cy,0,cx,cy,R*(1.4+0.12*pulse));
    sg.addColorStop(0,gc1);sg.addColorStop(0.5,gc2);sg.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=sg;ctx.beginPath();ctx.arc(cx,cy,R*(1.4+0.12*pulse),0,Math.PI*2);ctx.fill();
    const g=ctx.createRadialGradient(cx,cy,0,cx,cy,R*1.22);
    g.addColorStop(0,isLight?'rgba(0,80,120,.06)':'rgba(0,229,255,.035)');g.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=g;ctx.beginPath();ctx.arc(cx,cy,R*1.22,0,Math.PI*2);ctx.fill();
    /* ring — more visible in light mode */
    ctx.strokeStyle=isLight?'rgba(0,80,120,.45)':'rgba(0,229,255,.07)';ctx.lineWidth=isLight?1.5:1;
    ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.stroke();
    /* fibonacci dots — darker/denser in light mode */
    sdots.forEach(([px,py,pz])=>{
      const[rx,rz]=rotY(px,pz,rot);
      const[sx,sy]=proj(rx*R,py*R,rz*R,FOV);
      const d=(rz+1)/2;
      if(rz>-.15){
        ctx.fillStyle=isLight?`rgba(0,70,110,${(d*.7).toFixed(2)})`:`rgba(0,229,255,${(d*.36).toFixed(2)})`;
        ctx.beginPath();ctx.arc(sx,sy,isLight?1.3:1.05,0,Math.PI*2);ctx.fill();
      }
    });
    stack.forEach((t,i)=>{
      const[px,py,pz]=ll2v(t.lat,t.lon,1);
      const[rx,rz]=rotY(px,pz,rot);
      const[sx,sy]=proj(rx*R,py*R,rz*R,FOV);
      const[lx2,ly2,lz2]=ll2v(t.lat,t.lon,1.36);
      const[lrx,lrz]=rotY(lx2,lz2,rot);
      const[lsx,lsy]=proj(lrx*R,ly2*R,lrz*R,FOV);
      const op=rz>-.04?Math.min(1,(rz+.04)*2.8):0;
      if(op>.1){
        ctx.shadowColor=t.c;ctx.shadowBlur=isLight?3:5;ctx.fillStyle=t.c;
        ctx.beginPath();ctx.arc(sx,sy,3.2,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
        /* connector line — visible on both bg */
        ctx.strokeStyle=isLight?`rgba(0,60,100,${(op*.35).toFixed(2)})`:`rgba(255,255,255,${(op*.12).toFixed(2)})`;
        ctx.lineWidth=isLight?.8:.5;
        ctx.beginPath();ctx.moveTo(sx,sy);ctx.lineTo(lsx,lsy);ctx.stroke();
      }
      lels[i].style.transform=`translate(${lsx}px,${lsy}px) translate(-50%,-50%)`;
      lels[i].style.opacity=op.toFixed(2);
    });
    const ag=ctx.createRadialGradient(cx,cy,R*.92,cx,cy,R*1.13);
    ag.addColorStop(0,isLight?'rgba(0,80,120,0)':'rgba(0,229,255,0)');
    ag.addColorStop(1,isLight?'rgba(0,80,120,.2)':'rgba(0,229,255,.09)');
    ctx.fillStyle=ag;ctx.beginPath();ctx.arc(cx,cy,R*1.13,0,Math.PI*2);ctx.fill();
    if(!drag)rot+=vel;
    if(!drag&&Math.abs(vel)<.004)vel+=.00012;
    requestAnimationFrame(draw);
  }
  draw();
})();

/* GLOBE WARM PARTICLES */
(function(){
  const wrap=document.getElementById('globe-particles');
  if(!wrap)return;
  const colors=['rgba(255,180,60,.55)','rgba(255,140,40,.45)','rgba(255,200,80,.4)','rgba(255,100,20,.35)','rgba(255,220,100,.3)'];
  for(let i=0;i<22;i++){
    const p=document.createElement('div');p.className='gp';
    const size=Math.random()*3+1.5;
    const left=15+Math.random()*70;const top=20+Math.random()*60;
    const dur=4+Math.random()*8;const delay=-Math.random()*12;
    p.style.cssText=`width:${size}px;height:${size}px;left:${left}%;top:${top}%;background:${colors[Math.floor(Math.random()*colors.length)]};animation-duration:${dur}s;animation-delay:${delay}s;box-shadow:0 0 ${size*2}px ${colors[Math.floor(Math.random()*colors.length)]};`;
    wrap.appendChild(p);
  }
})();

/* ROLE ROTATION WITH TEXT SCRAMBLE */
(function(){
  const CHARS='!<>-_#$%^&*=+?01ABCDabcd';
  class Scramble{
    constructor(el){this.el=el;this.update=this.update.bind(this);}
    set(text){
      this.q=text.split('').map((to,i)=>({to,start:Math.floor(Math.random()*10),end:Math.floor(Math.random()*14)+22+i*2,char:''}));
      clearTimeout(this.raf);this.f=0;this.update();
      return new Promise(r=>{this.res=r;});
    }
    update(){
      let out='',done=0;
      for(const q of this.q){
        if(this.f>=q.end){done++;out+=q.to;}
        else if(this.f>=q.start){
          if(!q.char||Math.random()<.22)q.char=CHARS[Math.floor(Math.random()*CHARS.length)];
          out+=`<span style="color:rgba(0,229,255,.5)">${q.char}</span>`;
        }else out+=q.to===' '?' ':'&nbsp;';
      }
      this.el.innerHTML=out;
      if(done===this.q.length){this.res();return;}
      this.raf=setTimeout(()=>requestAnimationFrame(this.update),22);this.f++;
    }
  }
  const words=['Freelance','AI Builder','Full-Stack Dev','Go Developer','ML Engineer'];
  const live=document.getElementById('rw0');
  document.getElementById('rw1').style.display='none';
  document.getElementById('rw2').style.display='none';
  live.classList.add('active');
  const fx=new Scramble(live);
  let idx=0;
  (function next(){idx=(idx+1)%words.length;setTimeout(()=>fx.set(words[idx]).then(next),3800);})();
})();

/* BLOB PHOBIC — blob flees from mouse cursor */
(function(){
  const blob=document.querySelector('.hero-blob');
  const hero=document.getElementById('hero');
  if(!blob||!hero)return;
  let tx=0,ty=0,cx=0,cy=0;
  function getCenter(){
    const r=blob.getBoundingClientRect();
    return{x:r.left+r.width/2,y:r.top+r.height/2};
  }
  function lerp(a,b,t){return a+(b-a)*t;}
  let rafId;
  function loop(){
    tx=lerp(tx,cx,0.06);ty=lerp(ty,cy,0.06);
    blob.style.translate=`${tx.toFixed(1)}px ${ty.toFixed(1)}px`;
    rafId=requestAnimationFrame(loop);
  }
  loop();
  hero.addEventListener('mousemove',e=>{
    const c=getCenter();
    const dx=e.clientX-c.x,dy=e.clientY-c.y;
    const dist=Math.sqrt(dx*dx+dy*dy);
    const trigger=380;
    if(dist<trigger){
      const force=Math.pow(1-dist/trigger,1.6)*140;
      const ang=Math.atan2(dy,dx);
      cx=-Math.cos(ang)*force;
      cy=-Math.sin(ang)*force;
    }else{cx=0;cy=0;}
  },{passive:true});
  hero.addEventListener('mouseleave',()=>{cx=0;cy=0;});
})();

/* SCROLL REVEAL — bidirectional: fades in on enter, fades out on exit */
(function(){
  const io=new IntersectionObserver(e=>{
    e.forEach(x=>{
      if(x.isIntersecting){x.target.classList.add('vis');}
      else{x.target.classList.remove('vis');}
    });
  },{threshold:.08,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
})();

/* COUNTER ANIMATION */
(function(){
  const io=new IntersectionObserver(e=>{
    e.forEach(x=>{
      if(!x.isIntersecting)return;
      const el=x.target,tgt=+el.dataset.t;
      let s=0;const inc=tgt/88,timer=setInterval(()=>{s=Math.min(s+inc,tgt);el.textContent=Math.round(s);if(s>=tgt)clearInterval(timer);},16);
      io.unobserve(el);
    });
  },{threshold:.5});
  document.querySelectorAll('.cnum').forEach(el=>io.observe(el));
})();

/* ACTIVE SIDEBAR */
(function(){
  const links=document.querySelectorAll('.side-link');
  const secs=['works','project-1','globe','social','testimonials','details','contact'].map(id=>document.getElementById(id)).filter(Boolean);
  const io=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting)links.forEach(l=>l.classList.toggle('active',l.dataset.s===x.target.id));});},{threshold:.35});
  secs.forEach(s=>io.observe(s));
})();

/* DEVICE PARALLAX */
(function(){
  document.querySelectorAll('.proj-sec').forEach(sec=>{
    const dev=sec.querySelector('.dev-phone,.dev-laptop');if(!dev)return;
    sec.addEventListener('mousemove',e=>{const r=sec.getBoundingClientRect();const x=((e.clientX-r.left)/r.width-.5)*16;const y=((e.clientY-r.top)/r.height-.5)*-8;dev.style.transform=`perspective(1000px) rotateY(${x}deg) rotateX(${y}deg) translateZ(10px)`;});
    sec.addEventListener('mouseleave',()=>{dev.style.transform=sec.querySelector('.dev-phone')?'':'perspective(1000px) rotateY(-4deg) rotateX(2deg)';});
  });
})();

/* MAGNETIC BUTTONS */
(function(){
  document.querySelectorAll('.btn').forEach(b=>{
    b.addEventListener('mousemove',e=>{const r=b.getBoundingClientRect();b.style.transform=`translate(${(e.clientX-r.left-r.width/2)*.2}px,${(e.clientY-r.top-r.height/2)*.2}px)`;});
    b.addEventListener('mouseleave',()=>{b.style.transform='';});
  });
})();

/* CONTACT FORM — FormSubmit.co (free, no account needed) */
async function handleForm(e){
  e.preventDefault();
  const form=e.target;
  const btn=form.querySelector('[type=submit]');
  const ok=document.getElementById('cf-ok');
  const name=document.getElementById('cf-name').value.trim();
  const email=document.getElementById('cf-email').value.trim();
  const subject=document.getElementById('cf-subject').value.trim()||'Portfolio Inquiry';
  const msg=document.getElementById('cf-msg').value.trim();
  if(!name||!email||!msg){ok.textContent='⚠ Please fill all required fields.';ok.style.color='rgba(255,100,80,.9)';ok.classList.add('show');setTimeout(()=>ok.classList.remove('show'),4000);return;}
  btn.textContent='Sending…';btn.disabled=true;
  const data=new FormData();
  data.append('name',name);data.append('email',email);
  data.append('subject',subject);data.append('message',msg);
  data.append('_captcha','false');data.append('_template','basic');
  try{
    const res=await fetch('https://formsubmit.co/ajax/prabuddhaverma2548@gmail.com',{method:'POST',headers:{'Accept':'application/json'},body:data});
    const json=await res.json();
    if(json.success==='true'||json.success===true){
      ok.textContent='✓ Message sent! I\'ll get back to you soon.';ok.style.color='';ok.classList.add('show');form.reset();
    }else{throw new Error('Failed');}
  }catch(_){
    ok.textContent='✓ Redirecting to your email client…';ok.style.color='';ok.classList.add('show');
    const body=`Hi Prabuddha,\n\nFrom: ${name} (${email})\n\n${msg}`;
    window.open(`mailto:prabuddhaverma2548@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`);
  }finally{btn.textContent='Send Message';btn.disabled=false;setTimeout(()=>ok.classList.remove('show'),6000);}
}

/* BLOB FACE — wink + cursor tracking + expressions */
(function(){
  const hero=document.getElementById('hero');
  const eyeL=document.getElementById('bfey-l');
  const eyeR=document.getElementById('bfey-r');
  const mouth=document.getElementById('bface-mouth');
  if(!eyeL||!eyeR||!hero||!mouth)return;

  function wink(eye,dur){eye.classList.add('wink');setTimeout(()=>eye.classList.remove('wink'),dur||320);}
  setTimeout(()=>wink(eyeR,420),3400);
  setInterval(()=>{if(Math.random()<0.45)wink(Math.random()<0.5?eyeL:eyeR,300);},7500);

  /* EXPRESSIONS — smile / big smile / ooh / smirk */
  const EXPRS=[
    {d:'M5 6 Q28 22 51 6',   fill:'none',                    stroke:'rgba(0,229,255,.38)', dur:4500},
    {d:'M2 3 Q28 23 54 3',   fill:'none',                    stroke:'rgba(0,229,255,.52)', dur:2200},
    {d:'M22 5 C22 1 34 1 34 7 C34 17 22 17 22 7 C22 1 22 5 22 5', fill:'rgba(0,229,255,.12)', stroke:'rgba(0,229,255,.5)', dur:2000},
    {d:'M10 10 Q28 8 46 10', fill:'none',                    stroke:'rgba(0,229,255,.28)', dur:1600},
  ];
  let ei=0;
  function nextExpr(){
    const e=EXPRS[ei=(ei+1)%EXPRS.length];
    mouth.setAttribute('d',e.d);
    mouth.setAttribute('fill',e.fill);
    mouth.setAttribute('stroke',e.stroke);
    setTimeout(nextExpr,e.dur+Math.random()*1800);
  }
  setTimeout(nextExpr,4000);

  /* cursor tracking — stop when hero scrolls out */
  let active=true;
  new IntersectionObserver(e=>{active=e[0].isIntersecting;},{threshold:0.05}).observe(hero);
  const blob=document.querySelector('.hero-blob');
  const pupils=()=>document.querySelectorAll('.bface-pupil');
  document.addEventListener('mousemove',e=>{
    if(!active||!blob)return;
    const r=blob.getBoundingClientRect();
    const bx=r.left+r.width*.5,by=r.top+r.height*.5;
    const dx=e.clientX-bx,dy=e.clientY-by;
    const dist=Math.sqrt(dx*dx+dy*dy)||1;
    /* scale movement: more range on bigger eyes */
    const force=Math.min(dist/120,1);
    const px=(dx/dist)*7*force,py=(dy/dist)*7*force;
    pupils().forEach(p=>p.style.transform=`translate(${px.toFixed(1)}px,${py.toFixed(1)}px)`);
  },{passive:true});
  hero.addEventListener('mouseleave',()=>pupils().forEach(p=>p.style.transform=''));
})();


/* RESUME MODAL */
(function(){
  const btn=document.getElementById('resume-btn');
  const modal=document.getElementById('resume-modal');
  const bd=document.getElementById('rmodal-bd');
  const closeBtn=document.getElementById('rmodal-close');
  const frame=document.getElementById('rmodal-frame');
  const PREVIEW='https://drive.google.com/file/d/1RRvnps-w5-Cs7cgJ6mJjw8WeCFkOQHHl/preview';
  if(!btn||!modal)return;
  function open(){
    if(!frame.src||frame.src==='about:blank'||!frame.src.includes('drive'))frame.src=PREVIEW;
    modal.classList.add('open');modal.setAttribute('aria-hidden','false');
    document.body.style.overflow='hidden';
  }
  function close(){
    modal.classList.remove('open');modal.setAttribute('aria-hidden','true');
    document.body.style.overflow='';
  }
  btn.addEventListener('click',open);
  bd.addEventListener('click',close);
  closeBtn.addEventListener('click',close);
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))close();});
})();

/* BACK TO TOP */
(function(){
  const btt=document.getElementById('btt');
  window.addEventListener('scroll',()=>btt.classList.toggle('show',window.scrollY>500),{passive:true});
})();


/* THEME TOGGLE */
(function(){
  const btn=document.getElementById('theme-toggle');
  if(!btn)return;
  if(localStorage.getItem('theme')==='light')document.body.classList.add('light');
  btn.addEventListener('click',()=>{
    document.body.classList.toggle('light');
    localStorage.setItem('theme',document.body.classList.contains('light')?'light':'dark');
  });
})();

/* LOADER */
(function(){
  const loader=document.getElementById('loader');
  const nameEl=document.getElementById('ld-name');
  const pctEl=document.getElementById('ld-pct');
  const name='PRABUDDHA';
  /* stagger-reveal each letter */
  name.split('').forEach((ch,i)=>{
    const s=document.createElement('span');
    s.textContent=ch;
    s.style.cssText=`animation-delay:${0.3+i*0.06}s;transform:translateY(12px);`;
    nameEl.appendChild(s);
  });
  /* live % counter driven by ldFill animation timing */
  let pct=0;const pStart=Date.now();const pDur=2500;
  const pTick=setInterval(()=>{
    const t=Math.min(1,(Date.now()-pStart)/pDur);
    pct=Math.round(t<.6?t/.6*80:t<.85?(t-.6)/.25*13+80:(t-.85)/.15*7+93);
    if(pctEl)pctEl.textContent=pct+'%';
    if(pct>=100)clearInterval(pTick);
  },32);
  function dismiss(){
    if(loader)loader.classList.add('done');
    clearInterval(pTick);if(pctEl)pctEl.textContent='100%';
  }
  /* hide after 2.6s or when fully loaded */
  const minTime=new Promise(r=>setTimeout(r,2600));
  const pageLoad=new Promise(r=>{if(document.readyState==='complete')r();else window.addEventListener('load',r);});
  Promise.all([minTime,pageLoad]).then(dismiss);
})();

/* JELLY BLOBS — ambient gel across sections */
(function(){
  const blobs=[
    {sel:'#works',   x:'78%',y:'8%',  w:'420px',c1:'rgba(0,229,255,.055)',c2:'rgba(0,200,230,.02)',dur:'16s',del:'-3s'},
    {sel:'#works',   x:'5%', y:'55%', w:'320px',c1:'rgba(166,108,255,.05)',c2:'rgba(140,80,240,.015)',dur:'13s',del:'-9s'},
    {sel:'#social',  x:'8%', y:'10%', w:'380px',c1:'rgba(166,108,255,.06)',c2:'rgba(120,60,220,.02)',dur:'18s',del:'-5s'},
    {sel:'#social',  x:'70%',y:'55%', w:'350px',c1:'rgba(0,229,255,.05)',c2:'rgba(0,180,220,.015)',dur:'14s',del:'-11s'},
    {sel:'#testimonials',x:'60%',y:'5%',w:'400px',c1:'rgba(0,229,255,.05)',c2:'rgba(0,200,240,.015)',dur:'15s',del:'-7s'},
    {sel:'#testimonials',x:'-5%',y:'50%',w:'340px',c1:'rgba(166,108,255,.055)',c2:'transparent',dur:'17s',del:'-2s'},
    {sel:'#details', x:'72%',y:'20%', w:'360px',c1:'rgba(166,108,255,.06)',c2:'rgba(120,60,220,.02)',dur:'19s',del:'-6s'},
    {sel:'#contact', x:'75%',y:'55%', w:'380px',c1:'rgba(0,229,255,.055)',c2:'rgba(0,200,230,.02)',dur:'16s',del:'-4s'},
    {sel:'#contact', x:'2%', y:'15%', w:'300px',c1:'rgba(166,108,255,.05)',c2:'transparent',dur:'13s',del:'-10s'},
  ];
  blobs.forEach(b=>{
    const sec=document.querySelector(b.sel);
    if(!sec)return;
    const el=document.createElement('div');
    el.className='jelly-blob';
    el.style.cssText=`left:${b.x};top:${b.y};width:${b.w};height:${b.w};background:radial-gradient(circle,${b.c1} 0%,${b.c2} 55%,transparent 75%);--jd:${b.dur};--jdel:${b.del};`;
    sec.appendChild(el);
  });
})();
</script>
</body>
</html>